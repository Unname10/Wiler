<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#4A564A" />

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Kết nối thiết bị"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseConnection"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="#A0AFA0" />
        </RelativeLayout>

        <!-- Driver Status Badge -->
        <TextView
            android:id="@+id/tvDriverBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_badge_green"
            android:text="● Bluetooth HID Driver: Sẵn sàng"
            android:textColor="#22C55E"
            android:textSize="11sp" />

        <!-- Big Green Discoverable Action Card -->
        <LinearLayout
            android:id="@+id/cardDiscoverableAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_dark_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivDiscoverableIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_green"
                android:padding="8dp"
                android:src="@drawable/ic_bluetooth"
                app:tint="#22C55E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDiscoverableTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bật chế độ tìm kiếm"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiscoverableSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Make Discoverable"
                    android:textColor="#889988"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiscoverableTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:text="120\ngiây"
                android:textAlignment="center"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section: Bonded Devices -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Thiết bị đã ghép đôi"
                android:textColor="#D0DDD0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBondedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0 thiết bị"
                android:textColor="#667766"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Devices Container -->
        <LinearLayout
            android:id="@+id/containerBondedDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmptyDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Chưa có thiết bị nào ghép đôi. Hãy bật chế độ tìm kiếm để kết nối với PC!"
            android:textColor="#667766"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Auto-reconnect Bottom Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bluetooth"
                app:tint="#22C55E" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Tự động kết nối lại thiết bị gần nhất khi mở app"
                android:textColor="#D0DDD0"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutoReconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/xbox_green"
                app:trackTint="#263326" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
