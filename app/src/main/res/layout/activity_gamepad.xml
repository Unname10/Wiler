<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B08"
    android:keepScreenOn="true">

    <com.wiler.gamepad.ui.GamepadView
        android:id="@+id/gamepadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Disconnection Overlay -->
    <LinearLayout
        android:id="@+id/layoutDisconnectedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6080B08"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_bluetooth"
                app:tint="#EF4444" />

            <TextView
                android:id="@+id/tvDisconnectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mất kết nối với thiết bị"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDisconnectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Đang tự động thử kết nối lại... (1/3)"
                android:textColor="#889988"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOverlayExit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_danger_outline"
                    android:minHeight="0dp"
                    android:text="Về trang chủ"
                    android:textAllCaps="false"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOverlayRetry"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_green"
                    android:minHeight="0dp"
                    android:text="Thử lại ngay"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
