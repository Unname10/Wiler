<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B08"
    android:keepScreenOn="true">

    <!-- Interactive Canvas Editor View -->
    <com.wiler.gamepad.ui.GamepadEditView
        android:id="@+id/gamepadEditView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Header -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D90C120C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_danger_outline"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✕ Đóng"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Preset Selector Chips / Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetDefault"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_dark_selected"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Mặc định"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPreset1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_dark"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Preset 1"
                android:textAllCaps="false"
                android:textColor="#A0B0A0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPreset2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_dark"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Preset 2"
                android:textAllCaps="false"
                android:textColor="#A0B0A0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPreset3"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_dark"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Preset 3"
                android:textAllCaps="false"
                android:textColor="#A0B0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnResetAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_dark"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="↺ Đặt lại"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTogglePreview"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_dark"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="👁 Toàn cảnh"
            android:textAllCaps="false"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveLayout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_green"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="💾 Lưu bố cục"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Draggable Floating Toolbar for Element Customization -->
    <LinearLayout
        android:id="@+id/layoutBottomToolbar"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_dark"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Drag Handle Indicator & Collapse Toggle -->
        <RelativeLayout
            android:id="@+id/layoutDragHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_centerInParent="true"
                android:background="#4A564A" />

            <TextView
                android:id="@+id/btnToggleCollapse"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="▼"
                android:textColor="#A0B0A0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Selected Element Name & Actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvSelectedElementName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chạm vào một nút để chỉnh sửa"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnToggleClusterLock"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_dark_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🔒 Khóa cụm"
                    android:textColor="#22C55E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnResetElement"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_card_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="↺ Đặt lại nút"
                    android:textColor="#D0DDD0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Container for Sliders -->
        <LinearLayout
            android:id="@+id/containerSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Size Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:text="Kích thước:"
                    android:textColor="#889988"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderElementScale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="100"
                    android:valueFrom="60"
                    android:valueTo="160"
                    app:thumbColor="#22C55E"
                    app:trackColorActive="#22C55E"
                    app:trackColorInactive="#263326" />

                <TextView
                    android:id="@+id/tvElementScaleBadge"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spacing Slider Row (for D-pad / ABXY clusters) -->
            <LinearLayout
                android:id="@+id/rowElementSpacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:text="Khoảng cách:"
                    android:textColor="#889988"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderElementSpacing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="100"
                    android:valueFrom="60"
                    android:valueTo="160"
                    app:thumbColor="#22C55E"
                    app:trackColorActive="#22C55E"
                    app:trackColorInactive="#263326" />

                <TextView
                    android:id="@+id/tvElementSpacingBadge"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Show UI Button (Visible only in Fullscreen Preview Mode) -->
    <TextView
        android:id="@+id/btnFloatingShowUi"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_dark_selected"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="👁 Hiện giao diện"
        android:textColor="#22C55E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
