<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Menu Wiler"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseQuickMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="#A0AFA0" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnQuickResume"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_green"
        android:minHeight="0dp"
        android:text="Tiếp tục chơi"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnQuickEditLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_dark_selected"
        android:minHeight="0dp"
        android:text="🎨 Chỉnh sửa bố cục nút"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnQuickSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_dark_selected"
        android:minHeight="0dp"
        android:text="Cài đặt &amp; Vùng chết"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnQuickDisconnect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_danger_outline"
        android:minHeight="0dp"
        android:text="Ngắt kết nối tay cầm"
        android:textAllCaps="false"
        android:textColor="#EF4444"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnQuickExit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_dark"
        android:minHeight="0dp"
        android:text="Về màn hình chính"
        android:textAllCaps="false"
        android:textColor="#A0AFA0"
        android:textSize="14sp" />
</LinearLayout>
