<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Background Linear Gradient -->
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1024"
                android:endY="1024"
                android:type="linear">
                <item android:color="#FF1BA11B" android:offset="0.0" />
                <item android:color="#FF107C10" android:offset="0.55" />
                <item android:color="#FF0A5A0A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radial Glow at (300, 220) -->
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="300"
                android:centerY="220"
                android:gradientRadius="760"
                android:type="radial">
                <item android:color="#38FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
